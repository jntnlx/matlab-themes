  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#028009",
        "fontStyle": ""
      }
    },
    {
      "name": "Python docstrings as MATLAB help text",
      "scope": [
        "string.quoted.docstring",
        "string.quoted.docstring punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#028009",
        "fontStyle": ""
      }
    },
    {
      "name": "MATLAB cell titles",
      "scope": [
        "comment.line.double-percentage.matlab"
      ],
      "settings": {
        "foreground": "#028009",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string",
        "constant.character"
      ],
      "settings": {
        "foreground": "#AA04F9",
        "fontStyle": ""
      }
    },
    {
      "name": "String prefixes",
      "scope": [
        "storage.type.string",
        "storage.type.format"
      ],
      "settings": {
        "foreground": "#AA04F9",
        "fontStyle": ""
      }
    },
    {
      "name": "Unterminated strings / invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#C40000",
        "fontStyle": ""
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#0E00FF",
        "fontStyle": ""
      }
    },
    {
      "name": "Symbolic operators stay plain",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#000000",
        "fontStyle": ""
      }
    },
    {
      "name": "Word operators are keywords",
      "scope": [
        "keyword.operator.logical.python",
        "keyword.operator.word",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.delete",
        "keyword.operator.sizeof"
      ],
      "settings": {
        "foreground": "#0E00FF",
        "fontStyle": ""
      }
    },
    {
      "name": "Headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#C04C0B",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#0E00FF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#0E00FF",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Lists",
      "scope": [
        "markup.list punctuation.definition.list"
      ],
      "settings": {
        "foreground": "#0E00FF",
        "fontStyle": ""
      }
    },
    {
      "name": "Quotes",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#008013",
        "fontStyle": ""
      }
    },
    {
      "name": "Inline code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#0E00FF",
        "fontStyle": ""
      }
    },
    {
      "name": "Links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#1171BE",
        "fontStyle": ""
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#028009",
        "fontStyle": ""
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#C40000",
        "fontStyle": ""
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#A35A00",
        "fontStyle": ""
      }
    }
  ]
}
