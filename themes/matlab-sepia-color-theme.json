  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#0F4E0F",
        "fontStyle": ""
      }
    },
    {
      "name": "Python docstrings as MATLAB help text",
      "scope": [
        "string.quoted.docstring",
        "string.quoted.docstring punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#0F4E0F",
        "fontStyle": ""
      }
    },
    {
      "name": "MATLAB cell titles",
      "scope": [
        "comment.line.double-percentage.matlab"
      ],
      "settings": {
        "foreground": "#0F4E0F",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string",
        "constant.character"
      ],
      "settings": {
        "foreground": "#571484",
        "fontStyle": ""
      }
    },
    {
      "name": "String prefixes",
      "scope": [
        "storage.type.string",
        "storage.type.format"
      ],
      "settings": {
        "foreground": "#571484",
        "fontStyle": ""
      }
    },
    {
      "name": "Unterminated strings / invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#73120C",
        "fontStyle": ""
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#022395",
        "fontStyle": ""
      }
    },
    {
      "name": "Symbolic operators stay plain",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#1A1A18",
        "fontStyle": ""
      }
    },
    {
      "name": "Word operators are keywords",
      "scope": [
        "keyword.operator.logical.python",
        "keyword.operator.word",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.delete",
        "keyword.operator.sizeof"
      ],
      "settings": {
        "foreground": "#022395",
        "fontStyle": ""
      }
    },
    {
      "name": "Headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Lists",
      "scope": [
        "markup.list punctuation.definition.list"
      ],
      "settings": {
        "fontStyle": ""
      }
    },
    {
      "name": "Quotes",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "fontStyle": ""
      }
    },
    {
      "name": "Inline code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#571484",
        "fontStyle": ""
      }
    },
    {
      "name": "Links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#022395",
        "fontStyle": ""
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#0F4E0F",
        "fontStyle": ""
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#73120C",
        "fontStyle": ""
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#5F380E",
        "fontStyle": ""
      }
    }
  ]
}
